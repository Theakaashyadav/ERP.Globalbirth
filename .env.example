PORT=3000
API_PORT=3001

# Shared client key for web frontend and Android app.
# Send it as: Authorization: Bearer YOUR_KEY
CLIENT_API_KEY=change-this-long-random-key

# Optional stricter key for HR/marketing update actions.
# Leave empty to use only CLIENT_API_KEY protection.
ADMIN_API_KEY=
DASHBOARD_SESSION_SECRET=change-this-independent-long-random-secret

# Dashboard login users.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Admin

HR_USERNAME=hr
HR_PASSWORD=hr123
HR_NAME=HR Manager

MARKETING_USERNAME=marketing
MARKETING_PASSWORD=marketing123
MARKETING_NAME=Marketing Manager

# MongoDB Atlas connection string.
# Example:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/attendance_system?retryWrites=true&w=majority
MONGODB_URI=
# Optional Atlas plan capacity in bytes. Used only for the Admin Database Analysis utilization meter.
MONGODB_STORAGE_LIMIT_BYTES=

# Firebase Admin service account JSON, encoded as a single environment-variable value.
FIREBASE_SERVICE_ACCOUNT_JSON=
