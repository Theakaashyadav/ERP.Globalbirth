PORT=3000

# Shared client key for web frontend and Android app.
# Send it as: Authorization: Bearer YOUR_KEY
CLIENT_API_KEY=change-this-long-random-key

# Optional stricter key for HR update/delete actions.
# Leave empty to use only CLIENT_API_KEY protection.
ADMIN_API_KEY=

# Use mysql for Hostinger shared MySQL/MariaDB.
DB_CLIENT=mysql
HOSTINGER_DB_HOST=localhost
HOSTINGER_DB_PORT=3306
HOSTINGER_DB_USER=your_hostinger_db_user
HOSTINGER_DB_PASSWORD=your_hostinger_db_password
HOSTINGER_DB_NAME=your_hostinger_db_name

# Use postgres only if your Hostinger plan/VPS provides PostgreSQL.
# DB_CLIENT=postgres
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# DATABASE_SSL=false
